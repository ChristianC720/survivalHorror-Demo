  m_TableData:
  - m_Id: 951189504
    m_Localized: El orden es la mitad de la vida.
    m_Metadata:
      m_Items: []
  - m_Id: 1014104064
    m_Localized: La salud es un deber.
    m_Metadata:
      m_Items: []
  - m_Id: 1014104065
    m_Localized: Confidencial. No copiar.
    m_Metadata:
      m_Items: []
  - m_Id: 1014104066
    m_Localized: La seguridad es lo primero.
    m_Metadata:
      m_Items: []
  - m_Id: 1014104067
    m_Localized: Vitalis Konzern le agradece.
    m_Metadata:
      m_Items: []
  - m_Id: 1014104068
    m_Localized: Luces apagadas, mantenga la calma.
    m_Metadata:
      m_Items: []
  - m_Id: 1014104069
    m_Localized: Reporte los objetos encontrados.
    m_Metadata:
      m_Items: []
  - m_Id: 1014104070
    m_Localized: No correr.
    m_Metadata:
      m_Items: []
  - m_Id: 1014104071
    m_Localized: "Silencio en el \xE1rea de trabajo."
    m_Metadata:
      m_Items: []
  - m_Id: 1014104072
    m_Localized: "Use la munici\xF3n con moderaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 1014104073
    m_Localized: Primeros auxilios solo en emergencias.
    m_Metadata:
      m_Items: []
  - m_Id: 1014104074
    m_Localized: Videovigilancia activa.
    m_Metadata:
      m_Items: []
  - m_Id: 1014104075
    m_Localized: Prohibido el acceso no autorizado.
    m_Metadata:
      m_Items: []
  - m_Id: 1014104076
    m_Localized: "Nada debe quedar atr\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 1014104077
    m_Localized: El silencio es seguridad.
    m_Metadata:
      m_Items: []
  - m_Id: 1014104078
    m_Localized: "Progreso mediante la preservaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 1014104079
    m_Localized: Departamento de Mantenimiento
    m_Metadata:
      m_Items: []
  - m_Id: 1014104080
    m_Localized: FUERA DE SERVICIO
    m_Metadata:
      m_Items: []
  - m_Id: 1014104081
    m_Localized: ACTO I
    m_Metadata:
      m_Items: []
  - m_Id: 1014104082
    m_Localized: Seguridad de planta
    m_Metadata:
      m_Items: []
