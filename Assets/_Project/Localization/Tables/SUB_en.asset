  m_SharedData: {fileID: 11400000, guid: 2b828843787d449448d3dd73861bd1b7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1855164907520
    m_Localized: Lukas
    m_Metadata:
      m_Items: []
  - m_Id: 1855240404992
    m_Localized: THE MOTHER
    m_Metadata:
      m_Items: []
  - m_Id: 1855244599296
    m_Localized: Emilia
    m_Metadata:
      m_Items: []
  - m_Id: 1855244599297
    m_Localized: Containment breach. Transit suspended.
    m_Metadata:
      m_Items: []
  - m_Id: 1855244599298
    m_Localized: Specimen {0} is out of inventory. Initiating collection.
    m_Metadata:
      m_Items: []
  - m_Id: 1855244599299
    m_Localized: Visual containment active. Archived personnel released to assist.
    m_Metadata:
      m_Items: []
  - m_Id: 1855244599300
    m_Localized: Core exposed. Preservation of {0} is the priority. Please do not move.
    m_Metadata:
      m_Items: []
  - m_Id: 1855244599301
    m_Localized: Report 4,113. There is something under the archive. Field left blank.
    m_Metadata:
      m_Items: []
  - m_Id: 1855244599302
    m_Localized: "Subject {0}: identity not detected. Reclassified: decoy. Assigned to level \u22120."
    m_Metadata:
      m_Items: []
  - m_Id: 1855244599303
    m_Localized: New arrival detected. Initiating preservation protocol.
    m_Metadata:
      m_Items: []
  - m_Id: 1855244599304
    m_Localized: This is important. I don't remember why.
    m_Metadata:
      m_Items: []
  - m_Id: 1855244599305
    m_Localized: Is it mine? Or someone else's?
    m_Metadata:
      m_Items: []
  - m_Id: 1855244599306
    m_Localized: I know this handwriting.
    m_Metadata:
      m_Items: []
  - m_Id: 1855244599307
    m_Localized: There are more of these.
    m_Metadata:
      m_Items: []
  - m_Id: 1855244599308
    m_Localized: Someone was here not long ago.
    m_Metadata:
      m_Items: []
  - m_Id: 1855244599309
    m_Localized: I know this voice.
    m_Metadata:
      m_Items: []
  - m_Id: 1855244599310
    m_Localized: This photo shouldn't be here.
    m_Metadata:
      m_Items: []
  - m_Id: 1855244599311
    m_Localized: Again.
    m_Metadata:
      m_Items: []
  - m_Id: 1855244599312
    m_Localized: "\u2026Emilia."
    m_Metadata:
      m_Items: []
  - m_Id: 1855244599313
    m_Localized: "\u2026Lukas. I'm Lukas."
    m_Metadata:
      m_Items: []
  - m_Id: 238196427456512
    m_Localized: Lukas. If you're hearing this, it means I didn't come back.
    m_Metadata:
      m_Items: []
  - m_Id: 238196469399552
    m_Localized: There is something under the lab where I used to work. I worked at Vitalis for a long time and never asked what it was.
    m_Metadata:
      m_Items: []
  - m_Id: 238196469399553
    m_Localized: And when I did... That was all I did. I asked and everything went wrong.
    m_Metadata:
      m_Items: []
  - m_Id: 238196469399554
    m_Localized: I've gone back to find the thing I've been asking myself about for years. I don't know exactly what it is, but someone must know. Someone else has to.
    m_Metadata:
      m_Items: []
  - m_Id: 238196469399555
    m_Localized: Don't come looking for me. Please don't. Not you. Stay home. And if I don't come back, don't forget me.
    m_Metadata:
      m_Items: []
  - m_Id: 238196469399556
    m_Localized: "(breathing) \u2026it's in the walls. I can hear it from here."
    m_Metadata:
      m_Items: []
  - m_Id: 1093951087050752
    m_Localized: Dead. No way back.
    m_Metadata:
      m_Items: []
  - m_Id: 3065620953432064
    m_Localized: (footsteps, running)
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
