  m_SharedData: {fileID: 11400000, guid: b19fb095a3f758842bda067e84810967, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 230949035048960
    m_Localized: 'BIENVENIDO DE VUELTA, ESTIMADO COLEGA.

      Los bienes de la empresa se manipulan con [{0}].

      <i>Sicherheit geht vor.</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 230949106352128
    m_Localized: "SU TERMINAL DEL BRAZO RECUERDA PARA QUE USTED NO TENGA QUE HACERLO.\nCons\xFAltelo en cualquier momento: [{0}]. Pausas programadas: [{1}].\n<i>Vitalis Konzern dankt Ihnen.</i>"
    m_Metadata:
      m_Items: []
  - m_Id: 230949110546432
    m_Localized: "EN CASO DE OSCURIDAD: PULSE [{0}].\nLas bater\xEDas son propiedad de la empresa. No desperdicie la luz.\n<i>Licht aus, Ruhe bewahren.</i>"
    m_Metadata:
      m_Items: []
  - m_Id: 230949110546433
    m_Localized: 'TODO HALLAZGO DEBE DECLARARSE.

      Revise sus pertenencias con [{0}]. Recoja con [{1}].

      <i>Fundsachen melden.</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 230949114740736
    m_Localized: "SOLO SE PERMITE CORRER EN LOS PASILLOS EN CASO DE EMERGENCIA.\nMantenga [{0}]. Cuide su respiraci\xF3n.\n<i>Nicht rennen.</i>"
    m_Metadata:
      m_Items: []
  - m_Id: 230949114740737
    m_Localized: "EL RUIDO ES UN RIESGO LABORAL.\nMu\xE9vase en silencio: [{0}].\n<i>Ruhe im Betrieb.</i>"
    m_Metadata:
      m_Items: []
  - m_Id: 230949114740738
    m_Localized: "\xBFCONTACTO NO AUTORIZADO?\nEmpuje: [{0}]. Mantenga [{1}] para apuntar y dispare con [{0}]. Recarga: [{2}].\n<i>Munition sparsam verwenden.</i>"
    m_Metadata:
      m_Items: []
  - m_Id: 298167991140352
    m_Localized: 'VITALIS KONZERN

      <i>Gesundheit ist Pflicht.</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 298168066637824
    m_Localized: '<i>Ordnung ist das halbe Leben.</i>

      Abteilung Instandhaltung'
    m_Metadata:
      m_Items: []
  - m_Id: 298168066637825
    m_Localized: "<i>Ruhe ist Sicherheit.</i>\nVitalis Konzern \u2014 Werkschutz"
    m_Metadata:
      m_Items: []
  - m_Id: 298168066637826
    m_Localized: 'VITALIS KONZERN

      <i>Fortschritt durch Erhaltung.</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 1528817867948032
    m_Localized: "LOS PRIMEROS AUXILIOS SON UN PRIVILEGIO, NO UN DERECHO.\nAbra su terminal [{0}] y use un objeto [{1}] o desc\xE1rtelo [{2}].\n<i>Erste Hilfe nur im Notfall.</i>"
    m_Metadata:
      m_Items: []
  - m_Id: 1528817951834112
    m_Localized: "LA EMPRESA VE LO QUE USTED VE.\nCon\xE9ctese a las c\xE1maras cercanas: [{0}]. No se mueva mientras est\xE9 conectado.\n<i>Kamera\xFCberwachung aktiv.</i>"
    m_Metadata:
      m_Items: []
  - m_Id: 1528817951834113
    m_Localized: "PANELES DE MANTENIMIENTO: SOLO PERSONAL AUTORIZADO.\nEn un panel [{0}], introduzca el c\xF3digo con [{1}] [{2}] [{3}] [{4}]. Cancelar: [{5}]. Falla conocida: [{6}].\n<i>Unbefugter Zugriff verboten.</i>"
    m_Metadata:
      m_Items: []
  - m_Id: 1528817951834114
    m_Localized: "LOS COLEGAS FALLECIDOS NO PUEDEN QUEDAR SIN ATENDER.\nSobre un cuerpo: golpee [{0}] o clave un punz\xF3n de descarga [{1}].\n<i>Nichts darf zur\xFCckbleiben.</i>"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
