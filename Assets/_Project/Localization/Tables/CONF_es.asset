  m_TableData:
  - m_Id: 17772506644480
    m_Localized: Reloj de pulsera parado
    m_Metadata:
      m_Items: []
  - m_Id: 17772556976128
    m_Localized: "VK-INV-1031 - 2081-03-14\nReloj de pulsera encontrado en el subnivel B. Se detuvo a las 03:12 y la pila todav\xEDa funciona."
    m_Metadata:
      m_Items: []
  - m_Id: 17772556976129
    m_Localized: Termo con nombre rayado
    m_Metadata:
      m_Items: []
  - m_Id: 17772556976130
    m_Localized: "VK-INV-1047 - 2081-03-14\nTermo con caf\xE9 fr\xEDo, de un t\xE9cnico del subnivel A. El due\xF1o rasp\xF3 su propio nombre de la tapa."
    m_Metadata:
      m_Items: []
  - m_Id: 17772556976131
    m_Localized: Lentes de lectura con un cristal roto
    m_Metadata:
      m_Items: []
  - m_Id: 17772556976132
    m_Localized: "VK-INV-1052 - 2081-03-14\nLentes de lectura con un cristal roto, recogidas en la sala de calderas 2. Nadie las reclam\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 17772556976133
    m_Localized: Lonchera con una nota infantil
    m_Metadata:
      m_Items: []
  - m_Id: 17772556976134
    m_Localized: "VK-INV-1060 - 2081-03-14\nLonchera de un t\xE9cnico del taller C. Dentro hay una nota de un ni\xF1o que dice \"vuelve pronto\"."
    m_Metadata:
      m_Items: []
  - m_Id: 17772556976135
    m_Localized: Conejo de peluche con pulsera de hospital
    m_Metadata:
      m_Items: []
  - m_Id: 17772556976136
    m_Localized: "VK-INV-2004 - 2080-09-01\nConejo de peluche con una pulsera de hospital. Ingres\xF3 junto con un sujeto menor de edad."
    m_Metadata:
      m_Items: []
  - m_Id: 17772556976137
    m_Localized: Billetera con documento de identidad
    m_Metadata:
      m_Items: []
  - m_Id: 17772556976138
    m_Localized: "VK-INV-2018 - 2080-12-11\nCartera de un sujeto adulto. El documento de identidad est\xE1 dentro, pero la foto ya no se distingue."
    m_Metadata:
      m_Items: []
  - m_Id: 17772556976139
    m_Localized: "Rosario de pl\xE1stico"
    m_Metadata:
      m_Items: []
  - m_Id: 17772556976140
    m_Localized: "VK-INV-2023 - 2081-01-30\nRosario de pl\xE1stico de un sujeto adulto. Lo llev\xF3 en la mano durante todos los procedimientos."
    m_Metadata:
      m_Items: []
  - m_Id: 17772556976141
    m_Localized: Dibujo de una casa con un sol
    m_Metadata:
      m_Items: []
  - m_Id: 17772556976142
    m_Localized: "VK-INV-2031 - 2081-02-17\nDibujo de una casa con un sol, hecho por un sujeto menor de edad. El sujeto no recibi\xF3 el alta."
    m_Metadata:
      m_Items: []
  - m_Id: 17772556976143
    m_Localized: "Tapones para los o\xEDdos ensangrentados"
    m_Metadata:
      m_Items: []
  - m_Id: 17772556976144
    m_Localized: "VK-INV-3002 - 2081-03-14\nTapones para los o\xEDdos con sangre, recogidos en la central de megafon\xEDa. No fueron suficientes."
    m_Metadata:
      m_Items: []
  - m_Id: 17772556976145
    m_Localized: Placa del Werkschutz, puesto 7
    m_Metadata:
      m_Items: []
  - m_Id: 17772556976146
    m_Localized: "VK-INV-3009 - 2081-03-14\nPlaca del Werkschutz, puesto 7. Se avis\xF3 a Kessler y nadie vino a recogerla."
    m_Metadata:
      m_Items: []
  - m_Id: 17772556976147
    m_Localized: Casete etiquetada a mano "AKT I"
    m_Metadata:
      m_Items: []
  - m_Id: 17772556976148
    m_Localized: "VK-INV-3015 - 2081-03-14\nCasete con la etiqueta AKT I escrita a mano. Estaba dentro de la consola de la central de megafon\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 17772556976149
    m_Localized: "Aud\xEDfonos de estudio derretidos"
    m_Metadata:
      m_Items: []
  - m_Id: 17772556976150
    m_Localized: "VK-INV-3021 - 2081-03-14\nSe encontraron fundidos en un empleado de mantenimiento. El due\xF1o escuchaba una grabaci\xF3n sin parar."
    m_Metadata:
      m_Items: []
